@startuml cjm-customer
title CJM пользователя — от поиска блюда до доставки

start

:Заходит на Авито.Кухня;

split
  -[#green]-> знает, какое блюдо хочет;
  :Ищет блюдо по всем заведениям
  **GET /menu/search?query=пицца**;
  note right
    Отвечает на вопрос «где есть это блюдо»,
    а не «что есть у этого заведения».
    Поиск идёт по триграммному индексу.
  end note
  :Выбирает заведение из выдачи;
split again
  -[#green]-> выбирает заведение;
  :Смотрит список заведений
  **GET /restaurants?city=&cuisine=&open_only=**;
end split

:Открывает меню
**GET /restaurants/{id}/menu**;
note right
  Позиции в стоп-листе отдаются
  с is_available=false, а не скрываются:
  клиент показывает их неактивными.
end note

repeat :Собирает корзину;
  :Проверяет корзину
  **POST /cart/validate**;
  backward :Убирает или заменяет позицию;
repeat while (Есть проблемы?) is (да: подорожало\nили ушло в стоп-лист) not (нет)

:Оформляет заказ
**POST /orders**
заголовок X-Idempotency-Key;

switch (Ответ платформы)
case (409 Конфликт)
  :Заведение закрылось, позиция ушла
  в стоп-лист или изменилась цена;
  :Заказ не создан,
  пользователь правит корзину;
  stop
case (201 Создан)
  :Заказ создан в статусе created;
endswitch

:Отслеживает статус
**GET /orders/{id}**;

switch (Что происходит дальше)
case (Заведение приняло)
  :accepted, cooking, ready,
  delivering, delivered;
  :Заказ доставлен;
  stop
case (Заведение отклонило)
  :Статус rejected,
  в заказе видна причина отказа;
  stop
case (Пользователь передумал)
  :Отменяет заказ
  **POST /orders/{id}/cancel**;
  if (Заведение уже приняло?) then (да)
    :409 — отменить нельзя,
    заказ уже готовится;
    stop
  else (нет)
    :Заказ отменён;
    stop
  endif
endswitch

@enduml
